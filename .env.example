# ─── MediStock Production Environment Variables (.env) ────────────────────────
# Copy this to .env (or set directly in your Render service environment variables)

# Database Configuration (PostgreSQL)
# On Render: copy the 'External Database URL' or 'Internal Database URL' (starting with jdbc:postgresql://...)
DB_URL=jdbc:postgresql://db:5432/medistock_db
DB_USER=postgres
DB_PASSWORD=secretpassword
DB_NAME=medistock_db

# Port Configuration (Render automatically injects $PORT, default 8080 locally)
PORT=8080

# Security (JWT)
# Base64-encoded 256-bit secret key. You can generate one via: openssl rand -base64 32
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION=86400000

# CORS Allowed Origins
# Comma-separated list of origins. Wildcards like https://*.vercel.app are supported!
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://*.vercel.app

# ─── Email Alerts ─────────────────────────────────────────────────────────────
# Set EMAIL_ALERTS_ENABLED=true to send low-stock and expiry notification emails
EMAIL_ALERTS_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-16-char-app-password
